# LLM (optional). Without this, the app runs rule-only with zero external calls.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONFIDENCE_THRESHOLD=0.7
LLM_MAX_PAGES=20
LLM_TIME_BUDGET_MS=180000

# Vercel Blob (required on Vercel, not needed locally)
BLOB_READ_WRITE_TOKEN=
